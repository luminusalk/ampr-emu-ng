 use crate::rt::stats::{self, Stat};
+// Diagnostic trace (debug SPRX only). Stack buffer, sampled events, no allocation.
+// No changes to the pread backend, completion ordering, or worker count.
+#[cfg(feature = "mem_report")]
+static PREAD_DIAG_LOCK: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+#[cfg(feature = "mem_report")]
+static PREAD_DIAG_EVENTS: AtomicU64 = AtomicU64::new(0);
+
+#[cfg(feature = "mem_report")]
+struct PreadDiagLine {
+    bytes: [u8; 256],
+    used: usize,
+}
+
+#[cfg(feature = "mem_report")]
+impl core::fmt::Write for PreadDiagLine {
+    fn write_str(&mut self, value: &str) -> core::fmt::Result {
+        let src = value.as_bytes();
+        if src.len() > self.bytes.len() - self.used {
+            return Err(core::fmt::Error);
+        }
+        self.bytes[self.used..self.used + src.len()].copy_from_slice(src);
+        self.used += src.len();
+        Ok(())
+    }
+}
+
+// The event sequence is monotonic, including events that are sampled out.
+// Always log anomalies; sample regular events to avoid changing the timing
+// significantly and creating a new race by logging from every worker.
+#[cfg(feature = "mem_report")]
+fn pread_diag(
+    event: &str,
+    task_slot: usize,
+    request: &SceKernelAioRWRequest,
+    group_slot: u32,
+    group_generation: u32,
+    request_index: u32,
+    value: i64,
+    anomaly: bool,
+) {
+    use core::fmt::Write as _;
+    let seq = PREAD_DIAG_EVENTS.fetch_add(1, Ordering::Relaxed);
+    if !anomaly && seq >= 96 && seq % 32 != 0 {
+        return;
+    }
+    let mut line = PreadDiagLine { bytes: [0; 256], used: 0 };
+    let now = stats::now();
+    if write!(
+        &mut line,
+        "{} ns={} event={} slot={} fd={} offset={} len={} buf={:#x} result={:#x} group={}:{} part={} value={}\n",
+        seq,
+        now,
+        event,
+        task_slot,
+        request.fd,
+        request.offset,
+        request.nbyte,
+        request.buf as usize,
+        request.result as usize,
+        group_slot,
+        group_generation,
+        request_index,
+        value,
+    ).is_err() {
+        return;
+    }
+    // Do not serialize the physical reads; serialize only sampled log writes.
+    while PREAD_DIAG_LOCK.compare_exchange(false, true, Ordering::Acquire,
+                                          Ordering::Relaxed).is_err() {
+        core::hint::spin_loop();
+    }
+    // FreeBSD flags: O_WRONLY=1, O_APPEND=8, O_CREAT=0x200.
+    // The original _open is used to avoid re-entering the emulator's hooks.
+    let fd = unsafe {
+        sceKernelOpen(c"/data/ampr_pread_diag.log".as_ptr(), 1 | 8 | 0x200, 0o600)
+    };
+    if fd >= 0 {
+        let _ = unsafe { sceKernelWrite(fd, line.bytes.as_ptr().cast(), line.used) };
+        let _ = unsafe { sceKernelClose(fd) };
+    }
+    PREAD_DIAG_LOCK.store(false, Ordering::Release);
+}
